.venv/
env/
dist/
build/
*.egg

# Vector DB data (large, regeneratable)
chroma_data/
uploads/

# Node.js / Frontend
node_modules/
.next/
out/
.turbo/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

