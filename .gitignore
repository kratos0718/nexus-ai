# ============================================================
# NEXUS AI — Git Ignore
# CRITICAL: .env MUST be here — never commit API keys!
# ============================================================

# Environment & Secrets (NEVER COMMIT)
.env
.env.local
.env.*.local
*.key
*.pem
secrets/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
.venv/
env/
dist/
build/
*.egg

# Runtime data — regeneratable, never commit
chroma_data/
backend/chroma_data/
uploads/
backend/uploads/
*.db
backend/*.db

# Node.js / Frontend
node_modules/
.next/
out/
.turbo/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Logs
*.log
logs/

# Docker
docker/volumes/
