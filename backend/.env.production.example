# ============================================================
# NEXUS AI — Production Environment Variables (Railway)
# ============================================================
#
# HOW TO USE:
#   1. In the Railway dashboard, open your backend service
#   2. Go to Variables tab
#   3. Add each variable below
#
# Railway auto-injects DATABASE_URL and REDIS_URL when you add
# the Postgres and Redis plugins — do NOT set those manually.
# ============================================================

# ── REQUIRED ─────────────────────────────────────────────────

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-64-char-random-hex
JWT_SECRET_KEY=replace-with-different-64-char-random-hex

# Groq (free at console.groq.com)
GROQ_API_KEY=gsk_...

# ── SET BY RAILWAY PLUGINS (do not add manually) ──────────────
# DATABASE_URL=${{Postgres.DATABASE_URL}}   ← Postgres plugin
# REDIS_URL=${{Redis.REDIS_URL}}            ← Redis plugin

# ── CORS ─────────────────────────────────────────────────────
# Set to your Railway frontend URL after frontend is deployed
# Multiple origins: comma-separated, no spaces
ALLOWED_ORIGINS=https://nexus-frontend.up.railway.app

# ── OPTIONAL ─────────────────────────────────────────────────

# Logging: "json" recommended for production (structured logs)
LOG_FORMAT=json

# Embeddings (huggingface = local, openai = faster in cloud)
EMBEDDING_PROVIDER=huggingface

# Vector store (chroma = local on disk, pinecone = managed cloud)
VECTOR_STORE_PROVIDER=chroma

# Workers: 2 is safe for Railway's Hobby plan (512MB RAM)
# Increase only if you upgrade to a higher-memory plan
# WEB_CONCURRENCY=2
