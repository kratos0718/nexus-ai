# ============================================================
# NEXUS AI — Production Environment Variables
# ============================================================
#
# Copy this file to .env on your server and fill in the values.
# Never commit the filled-in .env to git.
#
# Works with any Linux host (VPS, Docker Compose, Render, etc.)
# ============================================================

# ── REQUIRED ─────────────────────────────────────────────────

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-64-char-random-hex
JWT_SECRET_KEY=replace-with-different-64-char-random-hex

# Free at console.groq.com — no card required
GROQ_API_KEY=gsk_...

# ── DATABASE ──────────────────────────────────────────────────
# PostgreSQL (recommended for production).
# Omit to fall back to SQLite (fine for single-user / demo).
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/nexus_ai

# ── REDIS ─────────────────────────────────────────────────────
# Enables query caching and rate limiting.
# Omit to run without cache (slower but functional).
REDIS_URL=redis://localhost:6379/0

# ── CORS ─────────────────────────────────────────────────────
# Set to your frontend's public URL.
# Multiple origins: comma-separated, no spaces.
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# ── EMBEDDINGS (free, no card) ────────────────────────────────
# Use HuggingFace Inference API instead of local sentence-transformers.
# Get a free token at huggingface.co → Settings → Access Tokens (no card).
EMBEDDING_PROVIDER=huggingface-api
HF_API_KEY=hf_...

# ── OPTIONAL ─────────────────────────────────────────────────

# Logging: "json" for production (structured logs), "text" for dev
LOG_FORMAT=json

# Vector store: "chroma" (local on disk) or "pinecone" (managed cloud)
VECTOR_STORE_PROVIDER=chroma
