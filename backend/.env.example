# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Required ──────────────────────────────────────────────────────────────────
SECRET_KEY=nexus-dev-secret-key-at-least-32-characters-long
JWT_SECRET_KEY=nexus-jwt-secret-key-at-least-32-characters-long

DATABASE_URL=sqlite+aiosqlite:///./nexus.db

# Get free key at: console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── Optional (app works without these) ────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

PINECONE_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
