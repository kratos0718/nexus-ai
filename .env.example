# ============================================================
# NEXUS AI — Environment Configuration Template
# Copy this to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# --- APPLICATION ---
APP_NAME=Nexus AI
APP_ENV=development          # development | staging | production
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=your-secret-key-here-minimum-32-characters

# --- API KEYS (LLM Providers) ---
# Groq: FREE tier — get key at https://console.groq.com (takes 2 minutes)
GROQ_API_KEY=gsk_...
# OpenAI: Add when you have a key — one config change to switch
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...   # Optional

# --- DATABASE ---
DATABASE_URL=postgresql://nexus_user:nexus_pass@localhost:5432/nexus_db

# --- REDIS (Cache + Queue) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- VECTOR DATABASE ---
# ChromaDB (local development)
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_NAME=nexus_documents

# Pinecone (production)
PINECONE_API_KEY=your-pinecone-key
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=nexus-production

# --- JWT AUTHENTICATION ---
JWT_SECRET_KEY=your-jwt-secret-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- EMBEDDING MODEL ---
# HuggingFace (FREE, local): all-MiniLM-L6-v2 → 384 dimensions
# OpenAI (paid): text-embedding-3-small → 1536 dimensions
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_PROVIDER=huggingface

# --- LLM SETTINGS ---
LLM_PROVIDER=groq                        # "groq" | "openai" | "anthropic"
LLM_MODEL=llama-3.3-70b-versatile       # Groq free model (switch to gpt-4o-mini with OpenAI key)
LLM_TEMPERATURE=0.1                      # Low temp = more factual, less creative
LLM_MAX_TOKENS=2000

# --- RAG SETTINGS ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=5
RERANKING_ENABLED=true

# --- MONITORING ---
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- FILE UPLOAD ---
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,docx,txt,md,csv
UPLOAD_DIR=./uploads
