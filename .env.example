# ============================================================
# NEXUS AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is in .gitignore.
# ============================================================

# ── Required ─────────────────────────────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_to_a_random_32_byte_hex_string

# ── Database ──────────────────────────────────────────────────
# Local dev: SQLite (default, no setup needed)
DATABASE_URL=sqlite+aiosqlite:///./nexus.db

# PostgreSQL (Docker Compose or cloud):
# DATABASE_URL=postgresql+asyncpg://nexus_user:nexus_pass@localhost:5432/nexus_db

# ── Redis ─────────────────────────────────────────────────────
# Optional — enables caching and rate limiting.
# Without Redis the system falls back to no-cache mode gracefully.
REDIS_URL=redis://localhost:6379/0

# ── Vector Store ──────────────────────────────────────────────
# "chroma"   → local ChromaDB (default, no API key needed)
# "pinecone" → Pinecone cloud (set PINECONE_API_KEY below)
VECTOR_STORE_PROVIDER=chroma

# Pinecone (only if VECTOR_STORE_PROVIDER=pinecone)
# PINECONE_API_KEY=your_pinecone_key
# PINECONE_INDEX_NAME=nexus-ai

# ── Embeddings ────────────────────────────────────────────────
# "huggingface" → all-MiniLM-L6-v2 local (default, free, 384-dim)
# "openai"      → text-embedding-3-small (requires OPENAI_API_KEY, 1536-dim)
EMBEDDING_PROVIDER=huggingface
# OPENAI_API_KEY=sk-your_key_here

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# ── Logging ───────────────────────────────────────────────────
# LOG_FORMAT: "text" (coloured, human-readable) or "json" (for log aggregators)
LOG_FORMAT=text
LOG_LEVEL=INFO

# ── Frontend (Next.js) ────────────────────────────────────────
# Must match where the FastAPI backend is running
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
